extends layout

block append variables
  - var title = "Post-Game Survey for Magic: The Gathering"
  - var appTitle = "Did You Have Fun?"
  - var description = "A friendly survey to give your friends after winning a game of Magic: The Gathering"
  - var slug = "survey"
  - var frontPage = false
  - var fullScreenPage = true

block headExtra
  link(rel="apple-touch-icon", href="/survey/icon-survey.png")

block viewport
  meta(name="viewport", content="width=device-width, initial-scale=1, viewport-fit=cover")

block content

